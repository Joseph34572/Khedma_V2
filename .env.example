# ============================================================================
# متغيرات البيئة المطلوبة للمشروع
# انسخ هذا الملف باسم .env.local وامْلأ القيم الحقيقية من لوحة تحكم Supabase
# لا تضع هذا الملف أبدًا في Git (موجود بالفعل داخل .gitignore)
# ============================================================================

# من: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# سرّي جدًا: لا يُستخدم إلا داخل كود الخادم (Server Actions) ولا يظهر للمتصفح أبدًا
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# اختياري (المرحلة الرابعة - الإشعارات الفورية على المتصفح عبر Web Push)
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
